# Secrets for the `assistant` Edge Function. Copy to .env, fill in, then push them to Supabase:
#   supabase secrets set --env-file supabase/functions/.env
# Free-tier key from aistudio.google.com (a project with billing turned off).
GEMINI_API_KEY=
# Optional; must be a free-tier model, otherwise gemini-3.6-flash is used
GEMINI_MODEL=gemini-3.6-flash
