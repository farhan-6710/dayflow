{
  "expo": {
    "name": "DayFlow",
    "slug": "personal-assistant-app",
    "owner": "farhan_6710",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f7f7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.expo.personalassistantapp",
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/ios-tinted.png",
        "backgroundColor": "#f4f7f7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "dev.expo.personalassistantapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ce9d820f-d43a-44e0-bd40-e8a3b71422b6"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/ios-tinted.png",
          "sounds": ["./assets/sounds/notification_sound.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f4f7f7",
          "dark": {
            "image": "./assets/icons/splash-icon-dark.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-font"
    ]
  }
}
